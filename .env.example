# Docker Compose settings
DATA_DIR=./data
EXTERNAL_PORT=8001

# Optional server settings
# BASE_URL=http://localhost:8001
# FILES_ROOT=/data
# MCP_TRANSPORT=streamable-http
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8000
# RAG_MCP_DATA=/store
# RAG_MCP_MODEL=BAAI/bge-small-en-v1.5
# FASTEMBED_CACHE_PATH=/models

# Optional OpenAI-compatible embeddings
# If any OPENAI_* var is set, HTTP embeddings are used instead of local fastembed.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDINGS_PATH=/embeddings
# OPENAI_TIMEOUT=60

# OpenRouter example
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=...
# RAG_MCP_MODEL=<embedding-model-id>

# Ollama example; no API key required
# OPENAI_BASE_URL=http://localhost:11434/v1
# RAG_MCP_MODEL=nomic-embed-text
